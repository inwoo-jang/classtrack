# 이 파일을 secrets.properties 로 복사한 뒤 실제 값을 채운다.
#   cp secrets.properties.example secrets.properties
#
# application.yaml 의 spring.config.import 가 읽어 들이며,
# 파일이 없으면 같은 이름의 환경변수로 대체된다.

DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=<username>
DB_PASSWORD=<password>

# 개발자 정보 (/api/developer). 비워두면 해당 API 는 404 를 돌려준다.
DEV_NAME=
DEV_EMAIL=
DEV_ROLE=
DEV_ORG=
DEV_GITHUB=
