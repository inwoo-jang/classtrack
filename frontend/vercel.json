{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "comment": "Vue Router 가 history 모드라 /courses/1 로 새로고침하면 서버에 그 경로를 요청한다. 그런 파일은 없으므로 index.html 을 돌려주고 라우팅은 브라우저가 하게 한다.",
      "source": "/((?!assets/|favicon|icon|apple-touch-icon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "comment": "해시가 붙은 번들은 내용이 바뀌면 파일명도 바뀌므로 영구 캐시해도 안전하다.",
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
